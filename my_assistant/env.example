# ============================================
# my_assistant 全栈环境变量模板
# 复制为 .env 后按需修改
# 应用启动: docker compose --env-file .env -f docker-compose.yml up -d
# 数据启动: docker compose --env-file .env -f docker-compose.data.yml up -d
# ============================================

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=my_assistant_db
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# ---------- Neo4j ----------
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_VERSION=5.26.0
NEO4J_PAGECACHE_SIZE=1G
NEO4J_HEAP_SIZE=2G

# ---------- MinIO (Milvus 依赖) ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Milvus ----------
MILVUS_VERSION=v2.6.1
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
MILVUS_MEMORY_LIMIT=8G
ATTU_VERSION=v2.5
ATTU_PORT=8001

# ---------- etcd ----------
ETCD_VERSION=v3.5.18

# ---------- 应用层 ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false
PRELOAD_LOCAL_MODEL=false
ENABLE_PERSISTENCE=true
CHECKPOINT_TYPE=sqlite
CHECKPOINT_DB_PATH=/app/data/checkpoints.db
ENABLE_MEMORY=true

# ---------- 备份路径 ----------
DOCKER_VOLUME_DIRECTORY=.
BACKUP_ROOT=/Users/fanyong/Desktop/code/python/docker_server/数据库数据备份