# ============================================
# 统一基础设施服务环境变量配置
# 复制为 .env 后使用: docker-compose -f docker-compose.infra.yml --env-file .env up -d
# ============================================

# ----------------------------------------
# Redis 配置
# ----------------------------------------
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# ----------------------------------------
# PostgreSQL 配置
# ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ----------------------------------------
# Milvus 配置
# ----------------------------------------
MILVUS_VERSION=v2.6.1
ETCD_VERSION=v3.5.18
MINIO_VERSION=RELEASE.2024-12-18T13-15-44Z
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----------------------------------------
# Neo4j 配置
# ----------------------------------------
NEO4J_VERSION=5.27.0
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ----------------------------------------
# Ollama 配置
# ----------------------------------------
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=qwen3:4b

# ----------------------------------------
# 项目适配指南
# ----------------------------------------
#
# 在 personal_ai 项目中使用:
#   REDIS_HOST=infra-redis
#   REDIS_PORT=6379
#   POSTGRES_HOST=infra-postgres
#   POSTGRES_PORT=5432
#   MILVUS_HOST=infra-milvus
#   MILVUS_PORT=19530
#   NEO4J_URI=bolt://infra-neo4j:7687
#   OLLAMA_BASE_URL=http://infra-ollama:11434
#
# 在 my_assistant 项目中使用:
#   同上，容器名称为 infra-*
#
# 启动命令:
#   cd /Users/fanyong/Desktop/code/python/docker_server
#   docker-compose -f docker-compose.infra.yml up -d
#
# 查看状态:
#   docker-compose -f docker-compose.infra.yml ps
#
# 停止服务:
#   docker-compose -f docker-compose.infra.yml down
