# ============================================
# personal_ai 项目环境变量配置
# 使用统一基础设施服务 (docker_server)
# ============================================

# ----------------------------------------
# 统一基础设施连接配置
# ----------------------------------------

# Redis
REDIS_HOST=infra-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
KB_REDIS_PASSWORD=redis123
KB_REDIS_PORT=6379

# PostgreSQL (使用独立数据库)
POSTGRES_HOST=infra-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=personal_ai_db
KB_POSTGRES_USER=postgres
KB_POSTGRES_PASSWORD=postgres123
KB_POSTGRES_DB=personal_ai_db
KB_POSTGRES_PORT=5432

# Milvus
MILVUS_HOST=infra-milvus
MILVUS_PORT=19530
KB_MILVUS_PORT=19530
KB_MILVUS_VERSION=v2.6.1

# Neo4j
NEO4J_URI=bolt://infra-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_VERSION=5.27.0

# Minio (Milvus依赖)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
KB_MINIO_ACCESS_KEY=minioadmin
KB_MINIO_SECRET_KEY=minioadmin
KB_MINIO_API_PORT=9000
KB_MINIO_CONSOLE_PORT=9001

# etcd (Milvus依赖)
ETCD_VERSION=v3.5.18
KB_ETCD_VERSION=v3.5.18

# Ollama
OLLAMA_BASE_URL=http://infra-ollama:11434
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=qwen3:4b

# ----------------------------------------
# 应用配置 (保留原有配置)
# ----------------------------------------

# API Keys
OPENAI_API_KEY=your_openai_key
DASHSCOPE_API_KEY=your_dashscope_key
DEEPSEEK_API_KEY=your_deepseek_key

# 其他应用配置...
