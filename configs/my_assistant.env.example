# ============================================
# my_assistant 项目环境变量配置
# 使用统一基础设施服务 (docker_server)
# ============================================

# ----------------------------------------
# 统一基础设施连接配置
# ----------------------------------------

# Redis
REDIS_HOST=infra-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# PostgreSQL (使用独立数据库)
POSTGRES_HOST=infra-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=my_assistant_db

# Neo4j
NEO4J_URI=bolt://infra-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# Ollama
OLLAMA_BASE_URL=http://infra-ollama:11434

# ----------------------------------------
# DashScope API
# ----------------------------------------
DASHSCOPE_API_KEY=your_dashscope_api_key

# ----------------------------------------
# LangGraph 配置
# ----------------------------------------
ENABLE_PERSISTENCE=true
CHECKPOINT_TYPE=sqlite
CHECKPOINT_DB_PATH=./data/checkpoints.db
ENABLE_MEMORY=true
MEMORY_STORE_TYPE=memory
MEMORY_MAX_ITEMS_PER_TYPE=1000
MEMORY_DEFAULT_LIMIT=10

# ----------------------------------------
# 应用配置
# ----------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
PRELOAD_LOCAL_MODEL=false
