# 统一基础设施环境变量模板
# 复制为 .env 后按需修改
# 说明：本文件变量仅被 infra/docker-compose.yml 消费；镜像版本在 compose 中已固定。

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# 业务库列表，由 ../scripts/init-multiple-dbs.sh 在初始化时建库
POSTGRES_MULTIPLE_DATABASES=personal_ai_db,my_assistant_db

REDIS_PASSWORD=redis123
REDIS_PORT=6379

NEO4J_VERSION=5.26.0
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

OLLAMA_PORT=11434
